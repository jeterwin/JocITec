  m_Script: {fileID: 11500000, guid: 1eff51274ff49ea4681ce0113fda63c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  manager: {fileID: 796467847}
  companionToSpawn: {fileID: 7545830644830087838, guid: ee9e845a1b7b03443b844a4c3244824f, type: 3}
  conversation:
  - characterName: Stratos
    characterIcon: {fileID: 0}
    sentence: "That\u2019s a lot of chain for a mountain with no flat ground, Lyra."
  - characterName: Lyra
    characterIcon: {fileID: 0}
    sentence: "It\u2019s not for the ground, Captain. It\u2019s for when the ground
      disappears."
  - characterName: Stratos
    characterIcon: {fileID: 0}
    sentence: "We\u2019re heading for the jagged peaks. There are no safety nets
      up there."
  - characterName: Lyra
    characterIcon: {fileID: 0}
    sentence: Good. Safety nets are for people who plan on falling. I plan on hanging
      on.
  - characterName: Stratos
    characterIcon: {fileID: 0}
    sentence: "Attach that hook to our cause and let\u2019s see how high you can
      pull us."
