  m_Script: {fileID: 11500000, guid: 1eff51274ff49ea4681ce0113fda63c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  manager: {fileID: 796467847}
  companionToSpawn: {fileID: 7545830644830087838, guid: 67eb16991fbab7e4fabac5a6dbd6bd7b, type: 3}
  conversation:
  - characterName: Argo
    characterIcon: {fileID: 0}
    sentence: You look like you're in a hurry to get nowhere, Not Madeline.
  - characterName: Not Madeline
    characterIcon: {fileID: 0}
    sentence: "Nowhere? I\u2019ve run this pass twice while you were still blinking."
  - characterName: Argo
    characterIcon: {fileID: 0}
    sentence: Mount Taygetus doesn't care about laps. It cares about crossing gaps.
  - characterName: Not Madeline
    characterIcon: {fileID: 0}
    sentence: I don't cross gaps, Argo. I blink past them before the wind can even
      catch me.
  - characterName: Argo
    characterIcon: {fileID: 0}
    sentence: "Prove that speed on the climb and you\u2019ve got a spot in the line."
