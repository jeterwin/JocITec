  m_Script: {fileID: 11500000, guid: 1eff51274ff49ea4681ce0113fda63c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  manager: {fileID: 1238543904}
  companionToSpawn: {fileID: 7545830644830087838, guid: f96fed30635380346a47e8bbd4af2186, type: 3}
  conversation:
  - characterName: Argo
    characterIcon: {fileID: 0}
    sentence: Those boots look heavy, Stratos. You sure you can actually lift them?
  - characterName: Stratos
    characterIcon: {fileID: 0}
    sentence: Heavy boots keep you from flying away when the gods start huffing,
      Argo.
  - characterName: Argo
    characterIcon: {fileID: 0}
    sentence: We need to reach the high ledges, not stay pinned to the dirt.
  - characterName: Stratos
    characterIcon: {fileID: 0}
    sentence: "I kick the air so hard it stays under my feet for a second. That\u2019s
      all I need."
  - characterName: Argo
    characterIcon: {fileID: 0}
    sentence: "If you can jump twice, you can definitely carry your weight. You\u2019re
      in."
